{
  "name": "voxmusica",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "type": "module",
  "engines": {
    "node": ">= 20 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "repository": {
    "url": "https://github.com/VoxMusica/VoxMusica-app"
  },
  "scripts": {
    "frontend:dev": "yarn workspace @voxmusica/frontend dev",
    "backend:dev": "yarn workspace @voxmusica/backend dev",
    "backend:worker": "yarn workspace @voxmusica/backend worker",
    "build": "yarn workspaces foreach -A run build",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5"
  }
}
