{
  "name": "VoxMusica-server",
  "version": "0.1.0",
  "description": "A music streaming server",
  "main": "index.ts",
  "repository": "https://github.com/VoxMusica/VoxMusica-server",
  "author": "Kamule",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">= 20 <27"
  },
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nodemon --exec \"node --conditions=development src/main.ts\"",
    "worker": "nodemon --exec \"node --conditions=development src/worker.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "cross-env NODE_OPTIONS=--conditions=development drizzle-kit generate",
    "db:migrate": "cross-env NODE_OPTIONS=--conditions=development drizzle-kit migrate",
    "db:studio": "cross-env NODE_OPTIONS=--conditions=development drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/caching": "^9.0.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@libsql/client": "^0.17.4",
    "abstract-cache": "^1.0.1",
    "abstract-cache-redis": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.2",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "lodash-es": "^4.18.1",
    "ms": "^2.1.3",
    "music-metadata": "^11.15.0",
    "node-taglib-sharp": "^6.0.3",
    "p-limit": "^7.3.1",
    "type-fest": "^5.8.0",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/convict": "^6.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "nodemonConfig": {
    "ignore": [
      "test/*",
      "local/*"
    ]
  }
}
