{
  "name": "VoxMusica-core",
  "version": "0.1.0",
  "description": "A tool to translate your music metadata",
  "main": "index.ts",
  "repository": "https://github.com/VoxMusica/VoxMusica-core",
  "author": "Kamule",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">= 20 <27"
  },
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nodemon --exec \"node --conditions=development src/main.ts\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "type-fest": "^5.8.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
