# Auto-generated from the convict config schema.
# Do not edit by hand — regenerate with: yarn workspace @voxmusica/backend generate-env-docs

# Port to listen on
PORT=4200

# Host to bind to
HOST=0.0.0.0

# Log level
LOG_LEVEL=info

# Directory to write log files to. If empty, logs go to stdout only.
LOG_DIR=

# Directory where the data are stored
DATA_DIR=/data

# JWT signing secret
JWT_SECRET=

# JWT expiry
JWT_TOKEN_EXPIRY=7d

# Session cookie secret
SESSION_COOKIE_SECRET=

# Path to music libraries
MUSIC_DIRS={}

# The source locales you want to translate
LOCALE_SOURCES=[]

# The target local you want to translate to
LOCALE_TARGET=en

# Enable cache
CACHE_ENABLED=true

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Fan art api key
FANART_API_KEY=

# AudioDB api key
AUDIO_DB_API_KEY=

# Spotify client id
SPOTIFY_CLIENT_ID=

# Spotify client secret
SPOTIFY_CLIENT_SECRET=

# Acoustid endpoint url
ACOUSTID_ENDPOINT=https://api.acoustid.org/v2/lookup

# Acoustid api key
ACOUSTID_API_KEY=
