{
  "name": "@voxmusica/backend",
  "version": "0.1.0",
  "description": "A music streaming server",
  "main": "index.ts",
  "repository": {
    "url": "https://github.com/VoxMusica/VoxMusica-server"
  },
  "author": "Kamule",
  "license": "GPL-3.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "prebuild": "tsx scripts/generate-user-agent.ts",
    "trigger": "cross-env NODE_OPTIONS=--conditions=development tsx scripts/trigger-job.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nodemon --exec \"node --conditions=development src/main.ts\"",
    "worker": "nodemon --config nodemon.worker.json --exec \"node --conditions=development src/worker.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "db:generate": "cross-env NODE_OPTIONS=--conditions=development drizzle-kit generate",
    "db:migrate": "cross-env NODE_OPTIONS=--conditions=development drizzle-kit migrate",
    "db:studio": "cross-env NODE_OPTIONS=--conditions=development drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/caching": "^9.0.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.2",
    "@libsql/client": "^0.17.4",
    "@voxmusica/types": "workspace:*",
    "abstract-cache-redis": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.2",
    "convict": "^6.2.5",
    "convict-format-with-validator": "^6.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "ms": "^2.1.3",
    "music-metadata": "^11.15.0",
    "musicbrainz-api": "^1.2.1",
    "node-taglib-sharp": "^6.0.3",
    "p-limit": "^7.3.1",
    "pino-pretty": "^13.1.3",
    "type-fest": "^5.8.0",
    "uuid": "^14.0.2",
    "winston-transport": "^4.9.0",
    "xmlbuilder2": "^4.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/convict": "^6.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "6.0.3"
  }
}
